# DealPilot Europe — environment template
# Copy to .env and fill in. Never commit real keys.

# Frontend-visible API base (the backend lives in server/).
# Leave blank to run fully on the local demo seed with no network calls.
# Local dev (wrangler dev on 8787): use /api so the Vite proxy forwards it.
VITE_PROJECT_API_BASE_URL=
# Deployed worker example:
# VITE_PROJECT_API_BASE_URL=https://dealpilot-api.<your-subdomain>.workers.dev

# Dev-only: where the Vite /api proxy forwards. Defaults to http://127.0.0.1:8787
API_PROXY_TARGET=http://127.0.0.1:8787

# ---------------------------------------------------------------------------
# Backend secrets (server/) — set with `wrangler secret put <NAME>`, never here.
# Local dev reads them from server/.dev.vars (see server/.dev.vars.example).
# ---------------------------------------------------------------------------
# eBay Browse API (free): https://developer.ebay.com
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# eBay Partner Network campaign id — enables monetized deeplinks.
# EBAY_AFFILIATE_CAMPAIGN_ID=
# EBAY_AFFILIATE_ROTATION_ID=
# Awin product feeds (join Awin, then paste feed JSON).
# AWIN_API_TOKEN=
# AWIN_PUBLISHER_ID=
# AWIN_FEED_URLS=[{"retailerId":"mediamarkt","name":"MediaMarkt","domain":"mediamarkt.de","advertiserId":1234,"url":"https://productdata.awin.com/..."}]
# Token for the manual ingestion endpoint POST /api/ingest (x-ingest-token header).
# INGEST_TOKEN=

# Notes on secrets:
# - Nothing with a key is ever given a VITE_ prefix; the browser only calls our
#   own backend, which holds the credentials.

# LLM provider for the shopping assistant (user supplied key, server-side only)
PROJECT_LLM_BASE_URL=https://api.example-llm-provider.com/v1
PROJECT_LLM_API_KEY=your-api-key-here
PROJECT_LLM_MODEL=your-model-name

# Note: there is no email/login/notification system in this build,
# so no email provider variables are needed.
