# DealPilot Europe — environment template
# Copy to .env and fill in. Never commit real keys.

# Backend / database (not implemented yet — frontend currently uses localStorage)
PROJECT_API_BASE_URL=http://localhost:8000
PROJECT_DATABASE_URL=postgres://user:password@localhost:5432/dealpilot

# Frontend-visible API base. Vite only exposes variables prefixed with VITE_.
# Leave blank to run in "architecture mode" (local catalogue matcher, no backend calls).
VITE_PROJECT_API_BASE_URL=

# Notes on secrets:
# - PROJECT_LLM_API_KEY / PROJECT_EMAIL_API_KEY are server-side ONLY.
#   They must never be given a VITE_ prefix or shipped to the browser.
# - The browser talks to our backend at VITE_PROJECT_API_BASE_URL; the backend
#   holds the keys and calls the provider.

# LLM provider for the shopping assistant (user supplied key)
PROJECT_LLM_BASE_URL=https://api.example-llm-provider.com/v1
PROJECT_LLM_API_KEY=your-api-key-here
PROJECT_LLM_MODEL=your-model-name

# Transactional email for price alerts
PROJECT_EMAIL_PROVIDER=your-email-provider
PROJECT_EMAIL_API_KEY=your-email-api-key-here
PROJECT_EMAIL_FROM=alerts@your-domain.example

# Affiliate network
PROJECT_AFFILIATE_NETWORK_ID=your-network-id
PROJECT_AFFILIATE_TRACKING_PARAM=ref

# Admin auth (required before exposing /admin.html publicly)
PROJECT_ADMIN_AUTH_SECRET=change-me
